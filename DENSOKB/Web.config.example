<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=301879
  -->
<configuration>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
	  <add key="connectionString" value="server=localhost;port=3307;uid=root;pwd=YOUR_PASSWORD;database=omsdb" />
	  <!-- 文件下载需要配置部署路径-->
	  <add key="apiPath" value="http://localhost:44324" />
	  <add key="TFTELian" value="Uploads\FTET\FTET直连配货标签模板.xlsx" />
	  <add key="FTETQRB" value="UploadFiles\FTET确认表模板5.xls" />
	  <add key="DHECSP" value="UploadFiles\DHEC_D.pdf" />
	    <!-- 文件解析存储路径-->
	  <add key="TFTEQRB" value="UploadFiles\FETE确认表模板2.xlsx" />
      <add key="FTCEQRB" value="UploadFiles\FTCE确认表模板.xls" />
      <add key="FTCEMDD" value="UploadFiles\FTEC补给品货垛标签.xlsx" />
      <add key="FTCEWXD" value="UploadFiles\FTEC外箱单.xlsx" />
	  <add key="FTCEWXDPDF" value="UploadFiles\FTEC外箱单.pdf" />
      <add key="CHAMQRB" value="UploadFiles\CHAM确认表.xls" />
	  <add key="FTETHD" value="UploadFiles\核对记录表.xlsx" />
	    <!-- 文件解析存储路径-->
	  <add key="fileUpload" value="D:\path\to\DENSOKB\UploadFiles" />
      <add key="OriUnit" value="UploadFiles\OriUnit"></add>
	  <!-- 长春量产接口地址-->
	  <add key="FTCElcPath" value="/FTCEdispose/CompressedFileFTCE" />
	  <!-- 长春补给接口地址-->
	  <!-- 东风本田接口地址-->
	  <add key="DHECPath" value="/DHECdispose/CompressedFileDHEC" />
	  <add key="FTCEbjPath" value="/FTECSupplies/CompressedFileFTCESupplies" />
	  <!-- 一汽发动机 量产+补给接口地址-->
	  <add key="FTETPath" value="/FTETdispose/CompressedFileFTET" />
      <add key="DHECPath" value="/DHECdispose/CompressedFileDHEC" />
      <add key="CHAMPath" value="/CHAMdispose/CompressedFileCHAM" />
      <add key="CHAMDisposeSummonPdf" value="/CHAMdispose/DisposeSummonPdf" />
      <add key="CHAMDisposeBoard" value="/CHAMdispose/DisposeBoard" />
      <add key="CHAMDisposeStackLabel" value="/CHAMdispose/DisposeStackLabel" />

    <!-- 直连Excel最大连号 一般不会变-->
	  <add key="TFTELLength" value="14" />
	  <!--SPIRE.PDF LICENSE-->
	  <add key="LicenseCategory" value="debug"/>
	  <add key="SpirePdfLicense" value ="YOUR_SPIRE_LICENSE"/>

  </appSettings>
  <!--
    有关 web.config 更改的说明，请参见 http://go.microsoft.com/fwlink/?LinkId=235367。

    可在 <httpRuntime> 标记上设置以下特性。
      <system.Web>
        <httpRuntime targetFramework="4.5.2" />
      </system.Web>
  -->
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.5.2" maxRequestLength="502400" executionTimeout="300000" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 单位：字节 (默认30MB，这里设为100MB) -->
        <requestLimits maxAllowedContentLength="504857600" />
      </requestFiltering>
    </security>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Antlr3.Runtime" publicKeyToken="eb42632606e9261f" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.0.2" newVersion="3.5.0.2" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" culture="neutral" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Optimization" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-1.1.0.0" newVersion="1.1.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" />
